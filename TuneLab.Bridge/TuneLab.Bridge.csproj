<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TuneLab.GUI\TuneLab.GUI.csproj" />
    <ProjectReference Include="..\TuneLab.Foundation\TuneLab.Foundation.csproj" />
    <ProjectReference Include="..\TuneLab.I18N\TuneLab.I18N.csproj" />
  </ItemGroup>

  <!-- 宿主侧桥接逻辑（协议/会话）与桥面板 UI 均 internal；经 InternalsVisibleTo 暴露给宿主与测试。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="TuneLab" />
    <InternalsVisibleTo Include="TuneLab.Tests" />
  </ItemGroup>

</Project>
